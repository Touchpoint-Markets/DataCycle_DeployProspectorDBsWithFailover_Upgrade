    <DTS:Executable
      DTS:refId="Package\Swap Diamond360 Databases"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{EF06746C-97CD-4E7B-AA59-1FAD6DA00224}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Swap Diamond360 Databases">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Swap Diamond360 Databases\On LIVE Swap Diamond360 with Diamond360_New"
          DTS:CreationName="Microsoft.DbMaintenanceTSQLExecuteTask"
          DTS:Description="Execute T-SQL Statement Task"
          DTS:DTSID="{5A1C5D8F-4BB7-400E-BD43-278753CC3704}"
          DTS:ExecutableType="Microsoft.DbMaintenanceTSQLExecuteTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="On LIVE Swap Diamond360 with Diamond360_New"
          DTS:TaskContact="Execute T-SQL Statement Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F3A93264-73B0-491B-9C07-7EEFC2AB18D9}"
              SQLTask:SqlStatementSource="ALTER DATABASE Diamond360_New SET SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;ALTER DATABASE Diamond360 SET SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;&#xA;ALTER DATABASE Diamond360 MODIFY NAME = Diamond360_Old&#xA;ALTER DATABASE Diamond360_New MODIFY NAME = Diamond360&#xA;&#xA;ALTER DATABASE Diamond360 SET MULTI_USER&#xA;ALTER DATABASE Diamond360_Old SET MULTI_USER&#xA;&#xA;ALTER DATABASE Diamond360  SET RECOVERY FULL WITH NO_WAIT"
              SQLTask:ServerVersion="9"
              SQLTask:ExtendedLogging="True"
              SQLTask:LocalConnectionForLogging=""
              SQLTask:TaskName=""
              SQLTask:IgnoreDatabasesInNotOnlineState="False" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Swap Diamond360 Databases\Re-add JDAUser and EBSA"
          DTS:CreationName="Microsoft.DbMaintenanceTSQLExecuteTask"
          DTS:Description="Execute T-SQL Statement Task"
          DTS:DTSID="{8F242E62-39CC-496C-90AA-54B6C2C830C1}"
          DTS:ExecutableType="Microsoft.DbMaintenanceTSQLExecuteTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Re-add JDAUser and EBSA"
          DTS:TaskContact="Execute T-SQL Statement Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F3A93264-73B0-491B-9C07-7EEFC2AB18D9}"
              SQLTask:SqlStatementSource="USE Diamond360&#xA;GO&#xA;&#xA;IF EXISTS (SELECT * FROM sys.database_principals WHERE name = N'jdauser')&#xA;DROP USER [jdauser]&#xA;GO&#xA;&#xA;CREATE USER [jdauser] FOR LOGIN [jdauser] WITH DEFAULT_SCHEMA=[jdauser]&#xA;GO&#xA;&#xA;ALTER ROLE [db_owner] ADD MEMBER [jdauser]&#xA;GO &#xA;&#xA;EXEC [Prospector].[dbo].[USP_UpdateEBSAViolationUserTracking]&#xA;GO&#xA;&#xA;IF EXISTS (SELECT * FROM sys.database_principals WHERE name = N'pentahouser')&#xA;DROP USER [pentahouser]&#xA;GO&#xA;&#xA;CREATE USER [pentahouser] FOR LOGIN [pentahouser] WITH DEFAULT_SCHEMA=[pentahouser]&#xA;GO&#xA;&#xA;ALTER ROLE [db_datareader] ADD MEMBER [pentahouser]&#xA;GO &#xA;&#xA;"
              SQLTask:ServerVersion="9"
              SQLTask:ExtendedLogging="True"
              SQLTask:LocalConnectionForLogging=""
              SQLTask:TaskName=""
              SQLTask:IgnoreDatabasesInNotOnlineState="False" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Swap Diamond360 Databases.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{FD071ECD-B167-4CCD-8F82-E94023D6EB04}"
          DTS:From="Package\Swap Diamond360 Databases\On LIVE Swap Diamond360 with Diamond360_New"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\Swap Diamond360 Databases\Re-add JDAUser and EBSA" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
