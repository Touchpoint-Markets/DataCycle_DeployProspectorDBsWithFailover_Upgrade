    <DTS:Executable
      DTS:refId="Package\SET TRUSTWORTHY Live"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6AAD8B86-DD14-46C7-8F86-341B01D88A4F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SET TRUSTWORTHY Live"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2012; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F3A93264-73B0-491B-9C07-7EEFC2AB18D9}"
          SQLTask:SqlStatementSource="USE Prospector&#xA;GO&#xA;ALTER DATABASE Prospector SET TRUSTWORTHY ON;&#xA;GO&#xA;USE Prospector&#xA;GO&#xA;EXEC sp_changedbowner 'sa'&#xA;GO&#xA;&#xA;&#xA;USE ProspectorExports&#xA;GO&#xA;ALTER DATABASE ProspectorExports SET TRUSTWORTHY ON;&#xA;GO&#xA;USE ProspectorExports&#xA;GO&#xA;EXEC sp_changedbowner 'sa'&#xA;GO&#xA;&#xA;&#xA;USE GroupInsurance&#xA;GO&#xA;ALTER DATABASE GroupInsurance SET TRUSTWORTHY ON;&#xA;GO&#xA;USE GroupInsurance&#xA;GO&#xA;EXEC sp_changedbowner 'sa'&#xA;GO&#xA;&#xA;&#xA;USE GroupInsuranceExports&#xA;GO&#xA;ALTER DATABASE GroupInsuranceExports SET TRUSTWORTHY ON;&#xA;GO&#xA;USE GroupInsuranceExports&#xA;GO&#xA;EXEC sp_changedbowner 'sa'&#xA;GO&#xA;&#xA;&#xA;USE Diamond360&#xA;GO&#xA;ALTER DATABASE Diamond360 SET TRUSTWORTHY ON;&#xA;GO&#xA;USE Diamond360&#xA;GO&#xA;EXEC sp_changedbowner 'sa'&#xA;GO&#xA;&#xA;&#xA;USE ExportLogging&#xA;GO&#xA;ALTER DATABASE ExportLogging SET TRUSTWORTHY ON;&#xA;GO&#xA;USE ExportLogging&#xA;GO&#xA;EXEC sp_changedbowner 'sa'&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SGH DATA"
      DTS:CreationName="Microsoft.DbMaintenanceTSQLExecuteTask"
      DTS:Description="Execute T-SQL Statement Task"
      DTS:DTSID="{6e5f13b1-fb1b-4570-95aa-b668d393a62c}"
      DTS:ExecutableType="Microsoft.DbMaintenanceTSQLExecuteTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SGH DATA"
      DTS:TaskContact="Execute T-SQL Statement Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F3A93264-73B0-491B-9C07-7EEFC2AB18D9}"
