          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{9C701B4B-CDE8-423D-A274-C8F66AE8A17E}"
              SQLTask:SqlStatementSource="USE Diamond360&#xA;GO&#xA;&#xA;IF EXISTS (SELECT * FROM sys.database_principals WHERE name = N'jdauser')&#xA;DROP USER [jdauser]&#xA;GO&#xA;&#xA;CREATE USER [jdauser] FOR LOGIN [jdauser] WITH DEFAULT_SCHEMA=[jdauser]&#xA;GO&#xA;&#xA;ALTER ROLE [db_owner] ADD MEMBER [jdauser]&#xA;GO &#xA;"
              SQLTask:ServerVersion="9"
              SQLTask:ExtendedLogging="True"
              SQLTask:LocalConnectionForLogging=""
              SQLTask:TaskName=""
              SQLTask:IgnoreDatabasesInNotOnlineState="False" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
