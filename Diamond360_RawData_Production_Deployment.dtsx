          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Net.Mail;
using System.Net;
#endregion

namespace ST_d1dcc50421ce46b99a9df5840ebc69a9
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private static string _importsDir = string.Empty;

        static ScriptMain()
        {
            AppDomain.CurrentDomain.AssemblyResolve += (sender, args) =>
            {
                var asmName = new System.Reflection.AssemblyName(args.Name);

                var dtsTasksDir = System.IO.Path.Combine(
                    System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles),
                    @"Microsoft SQL Server\160\DTS\Tasks");

                var nuget = (System.Environment.GetEnvironmentVariable("NUGET_PACKAGES")
                    ?? System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.UserProfile), ".nuget", "packages"))
                    .TrimEnd(new char[] { '\\', '/' }) + System.IO.Path.DirectorySeparatorChar.ToString();

                var map = new System.Collections.Generic.Dictionary<string, string[]>(System.StringComparer.OrdinalIgnoreCase)
                {
                    { "AWSSDK.Core",           new string[] { "AWSSDK.Core.dll",           nuget + @"awssdk.core\3.7.500\lib\net45\AWSSDK.Core.dll" } },
                    { "AWSSDK.SecretsManager", new string[] { "AWSSDK.SecretsManager.dll", nuget + @"awssdk.secretsmanager\3.7.500\lib\net45\AWSSDK.SecretsManager.dll" } }
                };

                string[] entry;
                if (!map.TryGetValue(asmName.Name, out entry)) return null;

                foreach (var dir in new string[] { _importsDir, dtsTasksDir })
                {
                    if (!string.IsNullOrEmpty(dir))
                    {
                        var candidate = System.IO.Path.Combine(dir, entry[0]);
                        if (System.IO.File.Exists(candidate))
                            return System.Reflection.Assembly.LoadFrom(candidate);
                    }
                }

                if (System.IO.File.Exists(entry[1]))
                    return System.Reflection.Assembly.LoadFrom(entry[1]);

                return null;
            };
        }

        private static string GetSecretString(string secretName, string region)
        {
            using (var client = new Amazon.SecretsManager.AmazonSecretsManagerClient(Amazon.RegionEndpoint.GetBySystemName(region)))
            {
                var response = client.GetSecretValue(new Amazon.SecretsManager.Model.GetSecretValueRequest { SecretId = secretName });
                return response.SecretString;
            }
        }

        private static string ExtractJsonStringField(string json, string fieldName)
        {
            var match = System.Text.RegularExpressions.Regex.Match(json, "\"" + fieldName + "\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"");
            if (!match.Success)
                throw new System.Exception("Field '" + fieldName + "' not found in secret.");
            return match.Groups[1].Value.Replace("\\\"", "\"").Replace("\\\\", "\\");
        }

        public void Main()
        {
            _importsDir = Dts.Variables["User::ImportsPath"].Value.ToString();
            RunMain();
        }

        private void RunMain()
        {
            int sendEmailFlag = (int)Dts.Variables["$Project::sendEmailFlag"].Value;

            if (sendEmailFlag == 1)
            {
                string smtpServer = Dts.Variables["$Project::SMTPServer"].Value.ToString();
                string awsSecretName = Dts.Variables["$Project::AwsSecretName"].Value.ToString();
                string awsRegion = Dts.Variables["$Project::AwsRegion"].Value.ToString();
                string smtpSecretJson = GetSecretString(awsSecretName, awsRegion);
                string smtpUserName = ExtractJsonStringField(smtpSecretJson, "UserName");
                string smtpPassword = ExtractJsonStringField(smtpSecretJson, "Password");
                string smtpFromAddress = Dts.Variables["$Project::SMTPFromAddress"].Value.ToString();

                System.Net.ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;
                string formattedDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
                MailMessage htmlMessage = new MailMessage();
                SmtpClient mySmtpClient;

                htmlMessage.From = new MailAddress(smtpFromAddress);
                htmlMessage.To.Add(new MailAddress("harshah@synoptek.com"));
                htmlMessage.CC.Add("Eric.ryles@arc-network.com,lynn.kruetzkamp@arc-network.com,hvaghasiya@synoptek.com,pallavi.dongle@infobeans.com,Ron.Lubke@arc-network.com,nitin.jain@infobeans.com,mbhavsar@synoptek.com");
                htmlMessage.Subject = "Diamond360_RawData_Production_Deployment" + " Completed Succesfully @ " + formattedDate;
                htmlMessage.IsBodyHtml = true;
                htmlMessage.Body = null;

                mySmtpClient = new SmtpClient(smtpServer);
                mySmtpClient.Port = 587;
                mySmtpClient.Credentials = new NetworkCredential(smtpUserName, smtpPassword);
                mySmtpClient.EnableSsl = true;
                mySmtpClient.Send(htmlMessage);
            }

            Dts.TaskResult = (int)ScriptResults.Success;

        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };

    }
}]]></ProjectItem>
