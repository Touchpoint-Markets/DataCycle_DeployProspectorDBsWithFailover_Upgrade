using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Net.Mail;
using System.Net;
#endregion

namespace ST_d1dcc50421ce46b99a9df5840ebc69a9
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            //string htmlMessageTo = Dts.Variables["HtmlEmailTo"].Value.ToString();
            //string htmlMessageCC = Dts.Variables["HtmlEmailCC"].Value.ToString();
            //string htmlMessageFrom = Dts.Variables["HtmlEmailFrom"].Value.ToString();
            //string htmlMessageSubject = Dts.Variables["HtmlEmailSubject"].Value.ToString();
            //string htmlMessageBody = Dts.Variables["LoadCounts"].Value.ToString();
            string smtpServer = "email-smtp.us-east-1.amazonaws.com";

            System.Net.ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;
            string formattedDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            MailMessage htmlMessage = new MailMessage();
            SmtpClient mySmtpClient;

            htmlMessage.From = new MailAddress("Diamond360DataCycle@judydiamond.com");
            htmlMessage.To.Add(new MailAddress("harshah@synoptek.com"));
            htmlMessage.CC.Add("eryles@alm.com,kveltri@alm.com,lkruetzkamp@alm.com,hvaghasiya@synoptek.com,pallavi.dongle@infobeans.com,rlubke@alm.com,nitin.jain@infobeans.com,mbhavsar@synoptek.com");
            htmlMessage.Subject = "Diamond360_RawData_Production_Deployment" + " Completed Succesfully @ " + formattedDate;
            htmlMessage.IsBodyHtml = true;
            htmlMessage.Body = null;

            mySmtpClient = new SmtpClient(smtpServer);
            mySmtpClient.Port = 587;
            mySmtpClient.Credentials = new NetworkCredential("AKIATN243CRFEH4NLTVX", "BHsyt7c3xysQ7TfkDODRbF+Lew7+x3goEJDzt1n65BK9");
            mySmtpClient.EnableSsl = true;
            mySmtpClient.Send(htmlMessage);

            //SendMailMessage(htmlMessageFrom, htmlMessageTo, htmlMessageCC, htmlMessageSubject, htmlMessageBody, true, smtpServer);

            Dts.TaskResult = (int)ScriptResults.Success;

        }

        //private void SendMailMessage(string From, string To, string CC, string Subject, string Body, bool IsBodyHtml, string Server)
