      DTS:DTSID="{39DD2337-28B7-4C20-8FD5-704EF651134E}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Swap Diamond360_RawData Databases">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Swap Diamond360_RawData Databases\On LIVE Swap Diamond360_RawData with Diamond360_RawData _New"
          DTS:CreationName="Microsoft.DbMaintenanceTSQLExecuteTask"
          DTS:Description="Execute T-SQL Statement Task"
          DTS:DTSID="{BD395AEA-8C7D-47B7-8824-5922FC56DA1B}"
          DTS:ExecutableType="Microsoft.DbMaintenanceTSQLExecuteTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="On LIVE Swap Diamond360_RawData with Diamond360_RawData _New"
          DTS:TaskContact="Execute T-SQL Statement Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F5A22BDA-CAAC-42E0-8E5D-DE1B3C9C8614}"
              SQLTask:SqlStatementSource="ALTER DATABASE Diamond360_RawData_New SET SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;ALTER DATABASE Diamond360_RawData SET SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;&#xA;ALTER DATABASE Diamond360_RawData MODIFY NAME = Diamond360_RawData_Old&#xA;ALTER DATABASE Diamond360_RawData_New MODIFY NAME = Diamond360_RawData&#xA;&#xA;ALTER DATABASE Diamond360_RawData SET MULTI_USER&#xA;ALTER DATABASE Diamond360_RawData_Old SET MULTI_USER&#xA;&#xA;ALTER DATABASE Diamond360_RawData  SET RECOVERY FULL WITH NO_WAIT"
              SQLTask:ServerVersion="9"
              SQLTask:ExtendedLogging="True"
              SQLTask:LocalConnectionForLogging=""
              SQLTask:TaskName=""
              SQLTask:IgnoreDatabasesInNotOnlineState="False" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Swap Diamond360_RawData Databases\Re-add JDAUser"
          DTS:CreationName="Microsoft.DbMaintenanceTSQLExecuteTask"
          DTS:Description="Execute T-SQL Statement Task"
          DTS:DTSID="{179A1B70-B7BA-4780-9CF8-342E6B17BEA1}"
          DTS:ExecutableType="Microsoft.DbMaintenanceTSQLExecuteTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Re-add JDAUser"
          DTS:TaskContact="Execute T-SQL Statement Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F5A22BDA-CAAC-42E0-8E5D-DE1B3C9C8614}"
              SQLTask:SqlStatementSource="USE Diamond360_RawData&#xA;GO&#xA;&#xA;IF EXISTS (SELECT * FROM sys.database_principals WHERE name = N'jdauser')&#xA;DROP USER [jdauser]&#xA;GO&#xA;&#xA;CREATE USER [jdauser] FOR LOGIN [jdauser] WITH DEFAULT_SCHEMA=[jdauser]&#xA;GO&#xA;&#xA;ALTER ROLE [db_owner] ADD MEMBER [jdauser]&#xA;GO &#xA;"
              SQLTask:ServerVersion="9"
              SQLTask:ExtendedLogging="True"
              SQLTask:LocalConnectionForLogging=""
              SQLTask:TaskName=""
              SQLTask:IgnoreDatabasesInNotOnlineState="False" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
