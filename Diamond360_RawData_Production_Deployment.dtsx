      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package.EventHandlers[OnError]\Send Mail on Error"
          DTS:CreationName="Microsoft.ScriptTask"
          DTS:Description="Script Task"
          DTS:DTSID="{99d53cc3-fac1-4ad0-bb48-f449141720a3}"
          DTS:ExecutableType="Microsoft.ScriptTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Send Mail on Error">
          <DTS:Variables />
          <DTS:ObjectData>
            <ScriptProject
              Name="ST_d2e720742fed445a82b5e4e37d10cb85"
              VSTAMajorVersion="17"
              VSTAMinorVersion="0"
              Language="CSharp"
              ReadOnlyVariables="System::PackageName, System::SourceName, System::SourceDescription, System::ErrorDescription, System::ErrorCode">
              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Net.Mail;
using System.Net;
#endregion

namespace ST_d1dcc50421ce46b99a9df5840ebc69a9
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            string packageName = Dts.Variables["System::PackageName"].Value.ToString();
            string sourceName = Dts.Variables["System::SourceName"].Value.ToString();
            string sourceDescription = Dts.Variables["System::SourceDescription"].Value.ToString();
            string errorDescription = Dts.Variables["System::ErrorDescription"].Value.ToString();
            int errorCode = (int)Dts.Variables["System::ErrorCode"].Value;

            string errorMessage =
                "Error Details:\n\n" +
                "Package – " + packageName + ".dtsx\n\n" +
                "Task – " + sourceName + "\n\n" +
                "Task Type (SSIS Component) – " + sourceDescription + "\n\n" +
                "Error Description – " + errorDescription + "\n\n" +
                "Error Code – " + errorCode.ToString() + "\n\n";

            string smtpServer = "email-smtp.us-east-1.amazonaws.com";

            System.Net.ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;
            string formattedDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            MailMessage htmlMessage = new MailMessage();
            SmtpClient mySmtpClient;

            htmlMessage.From = new MailAddress("ErrorOnCycle@judydiamond.com");
            htmlMessage.To.Add(new MailAddress("harshah@synoptek.com"));
            htmlMessage.CC.Add("hvaghasiya@synoptek.com");
            htmlMessage.Subject = "Diamond360_DataCycle_Error" + " @ " + formattedDate;
            htmlMessage.IsBodyHtml = true;
            htmlMessage.Body = errorMessage;

            mySmtpClient = new SmtpClient(smtpServer);
            mySmtpClient.Port = 587;
