        <DTS:PrecedenceConstraint
          DTS:refId="Package\Swap Diamond360_RawData Databases.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{5A2C6719-867F-4D4D-A8B0-F57DBDD3E5D7}"
          DTS:From="Package\Swap Diamond360_RawData Databases\On LIVE Swap Diamond360_RawData with Diamond360_RawData _New"
